{
  "schemaVersion": 1,
  "packages": {
    "akar": {
      "repository": "vinicunca/akar",
      "tagPattern": "^v2\\.0\\.[0-9]+$",
      "pages": [
        {
          "source": "docs/index.md",
          "destination": "content/akar/1.index.md"
        },
        {
          "source": "docs/getting-started.md",
          "destination": "content/akar/getting-started.md"
        },
        {
          "source": "docs/guides/dialog.md",
          "destination": "content/akar/guides/dialog.md"
        },
        {
          "source": "docs/guides/index.md",
          "destination": "content/akar/guides/1.index.md"
        }
      ],
      "metadata": {
        "destination": "server/data/akar-components.json"
      }
    },
    "eslint": {
      "repository": "vinicunca/eslint-config",
      "tagPattern": "^v5\\.[0-9]+\\.[0-9]+$",
      "pages": [
        {
          "source": "docs/index.md",
          "destination": "content/eslint.md"
        }
      ]
    },
    "perkakas": {
      "repository": "vinicunca/perkakas",
      "tagPattern": "^v1\\.[0-9]+\\.[0-9]+$",
      "pages": [
        {
          "source": "docs/index.md",
          "destination": "content/perkakas/1.index.md"
        }
      ],
      "metadata": {
        "destination": "server/data/metadata.json"
      }
    },
    "pohon": {
      "repository": "vinicunca/pohon",
      "tagPattern": "^v2\\.0\\.[0-9]+(?:-rc[0-9]+(?:\\.[0-9]+)?)?$",
      "pages": [],
      "generatedDocs": "pohon-nuxt-raw",
      "metadata": {
        "destination": "server/data/pohon-components.json"
      }
    },
    "taman": {
      "repository": "vinicunca/taman",
      "tagPattern": "^docs-v[0-9]+\\.[0-9]+\\.[0-9]+$",
      "pages": [
        {
          "source": "packages/taman-core/README.md",
          "destination": "content/taman/core.md",
          "format": "readme",
          "title": "Taman Core",
          "description": "Foundation utilities, state, and Vue composables for Taman."
        },
        {
          "source": "packages/taman-ui/README.md",
          "destination": "content/taman/ui.md",
          "format": "readme",
          "title": "Taman UI",
          "description": "Unstyled Vue components and application patterns for Taman."
        },
        {
          "source": "packages/request/README.md",
          "destination": "content/taman/request.md",
          "format": "readme",
          "title": "Request",
          "description": "Typed oRPC and HTTP request clients."
        }
      ],
      "directories": [
        {
          "source": "docs/public",
          "destination": "content/taman"
        }
      ]
    },
    "unocss-preset": {
      "repository": "vinicunca/unocss-preset-vinicunca",
      "tagPattern": "^v2\\.[0-9]+\\.[0-9]+$",
      "pages": [],
      "directories": [
        {
          "source": "docs/content",
          "destination": "content/unocss-preset"
        }
      ]
    },
    "unocss-variants": {
      "repository": "praburangki/unocss-variants",
      "tagPattern": "^v1\\.[0-9]+\\.[0-9]+$",
      "pages": [],
      "directories": [
        {
          "source": "docs/content",
          "destination": "content/unocss-variants"
        }
      ]
    }
  }
}
